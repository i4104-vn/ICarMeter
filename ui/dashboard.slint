// Dashboard window. Feature sections are defined in ./components.

import { Tile } from "@mapping/map.slint";
import { TpmsPanel } from "components/tpmspanel.slint";
import { SpeedPanel } from "components/speedpanel.slint";
import { TripPanel } from "components/trippanel.slint";

export component AppWindow inherits Window {
    title: "ICarMeter Digital Dashboard";
    width: 1280px;
    height: 480px;
    background: #000000;

    callback toggle_mode();
    callback toggle_bt_log();
    callback demo_gps();
    callback quit();
    callback map_pan(length, length);
    callback map_zoom_by(float, length, length);
    callback map_follow();
    forward-focus: keyboard-focus;

    keyboard-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == "m" || event.text == "M") {
                root.toggle_mode();
            } else if (event.text == "b" || event.text == "B") {
                root.toggle_bt_log();
            } else if (event.text == "a" || event.text == "A") {
                root.demo_gps();
            } else if (event.text == "g" || event.text == "G") {
                root.map_follow();
            } else if (event.text == "q" || event.text == "Q") {
                root.quit();
            }
            accept
        }
    }

    // Telemetry Properties bound to Rust backend
    in-out property <float> speed: 0.0;
    in property <int> emo_random_seed: 1;
    in-out property <string> driving_time: "00:00:00";
    in-out property <string> distance: "0.0 km";
    in-out property <string> max_speed: "0 km/h";
    in-out property <string> avg_speed: "0 km/h";

    // TPMS Properties
    in-out property <bool> tpms_enabled: true;
    in-out property <float> fl_pressure: 0.0;
    in-out property <float> fr_pressure: 0.0;
    in-out property <float> rl_pressure: 0.0;
    in-out property <float> rr_pressure: 0.0;
    in-out property <float> fl_temp: 0.0;
    in-out property <float> fr_temp: 0.0;
    in-out property <float> rl_temp: 0.0;
    in-out property <float> rr_temp: 0.0;
    in-out property <float> alert_pressure: 2.2;
    in-out property <float> alert_temp: 70.0;

    // Connectivity & Modes
    in-out property <bool> bt_active: true;
    in-out property <string> bt_device_name: "Bluetooth";
    in-out property <bool> gps_connected: false;
    in-out property <float> map_latitude: 21.0285;
    in-out property <float> map_longitude: 105.8542;
    in-out property <float> map_zoom: 3.0;
    in-out property <bool> map_following: true;
    in property <[Tile]> map_tiles;
    in property <bool> map_tiles_available: false;
    in-out property <bool> show_bt_log: false;
    in-out property <string> latest_bt_log: "Bluetooth RFCOMM service running.";

    // Original 1280×480 three-column layout: map, speed/emotions, trip stats.
    TpmsPanel {
        x: 0px;
        y: 0px;
        width: 410px;
        height: 480px;
        tpms_enabled: root.tpms_enabled;
            fl_pressure: root.fl_pressure;
            fr_pressure: root.fr_pressure;
            rl_pressure: root.rl_pressure;
            rr_pressure: root.rr_pressure;
            fl_temp: root.fl_temp;
            fr_temp: root.fr_temp;
            rl_temp: root.rl_temp;
            rr_temp: root.rr_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
            gps_connected: root.gps_connected;
            map_latitude <=> root.map_latitude;
            map_longitude <=> root.map_longitude;
            map_zoom <=> root.map_zoom;
            map_following: root.map_following;
            map_tiles: root.map_tiles;
            map_tiles_available: root.map_tiles_available;
            map_pan(dx, dy) => { root.map_pan(dx, dy); }
            map_zoom_by(delta, x, y) => { root.map_zoom_by(delta, x, y); }
            map_follow() => { root.map_follow(); }
    }

    Rectangle {
        x: 409px;
        y: 35px;
        width: 1px;
        height: 390px;
        background: #1c1c20;
    }

    SpeedPanel {
        x: 410px;
        y: 0px;
        width: 460px;
        height: 480px;
        speed: root.speed;
        random_seed: root.emo_random_seed;
        show_bt_log: root.show_bt_log;
        latest_bt_log: root.latest_bt_log;
    }

    Rectangle {
        x: 870px;
        y: 35px;
        width: 1px;
        height: 390px;
        background: #1c1c20;
    }

    TripPanel {
        x: 871px;
        y: 0px;
        width: 409px;
        height: 480px;
        driving_time: root.driving_time;
        distance: root.distance;
        max_speed: root.max_speed;
        avg_speed: root.avg_speed;
        bt_active: root.bt_active;
        bt_device_name: root.bt_device_name;
        gps_connected: root.gps_connected;
    }
}
