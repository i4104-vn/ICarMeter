// Tire pressure badges and vehicle diagram.

export component TireBadge {
    in property <string> wheel_name: "FL";
    in property <float> pressure: 0.0;
    in property <float> temperature: 0.0;
    in property <float> alert_pressure: 2.2;
    in property <float> alert_temp: 70.0;
    in property <bool> is_connected: pressure > 0.0;

    property <bool> is_low: is_connected && pressure < alert_pressure;
    property <bool> is_high_temp: is_connected && temperature >= alert_temp;
    property <color> badge_color: !is_connected ? #4b5563 : (is_low || is_high_temp ? #ef4444 : #00e5ff);

    width: 104px;
    height: 68px;

    Rectangle {
        background: #0f172a.mix(root.badge_color, 12%);
        border-width: 1.5px;
        border-color: root.badge_color.transparentize(30%);
        border-radius: 8px;

        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 2px;

            HorizontalLayout {
                Text {
                    text: root.wheel_name;
                    font-size: 11px;
                    font-weight: 700;
                    color: root.badge_color;
                }
                Text {
                    text: root.is_connected ? "\{Math.round(root.temperature)}°C" : "--";
                    font-size: 11px;
                    font-weight: 500;
                    horizontal-alignment: right;
                    color: root.is_high_temp ? #ef4444 : #94a3b8;
                }
            }

            Text {
                text: root.is_connected ? "\{Math.round(root.pressure * 10) / 10} bar" : "OFFLINE";
                font-size: 15px;
                font-weight: 800;
                color: !root.is_connected ? #64748b : (root.is_low ? #ef4444 : #f8fafc);
                horizontal-alignment: center;
            }

            Rectangle {
                height: 2px;
                background: root.badge_color;
                border-radius: 1px;
            }
        }
    }
}

export component CarChassis {
    width: 140px;
    height: 260px;

    // Body shadow / underglow
    Rectangle {
        x: 10px;
        y: 15px;
        width: 120px;
