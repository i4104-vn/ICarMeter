import { TireBadge, CarChassis } from "tpms.slint";

export component TpmsPanel inherits Rectangle {
    in property <bool> tpms_enabled;
    in property <float> fl_pressure;
    in property <float> fr_pressure;
    in property <float> rl_pressure;
    in property <float> rr_pressure;
    in property <float> fl_temp;
    in property <float> fr_temp;
    in property <float> rl_temp;
    in property <float> rr_temp;
    in property <float> alert_pressure;
    in property <float> alert_temp;
    in property <bool> gps_connected;

    // Dynamic Speed Waveform Chart Properties
    in property <float> speed: 0.0;
    in property <string> chart_stroke_path: "M 0 205 L 370 205";
    in property <string> chart_area_path: "M 0 205 L 370 205 L 370 205 L 0 205 Z";
    in property <float> chart_endpoint_x: 370.0;
    in property <float> chart_endpoint_y: 205.0;
    in property <bool> chart_endpoint_visible: false;

    callback toggle_mode();

    width: 410px;
    height: 480px;
    background: #000000;

    // VIEW 1: TPMS TIRE TELEMETRY
    if root.tpms_enabled: Rectangle {
        // Center Car Graphic
        CarChassis {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + 10px;
        }

        // 4 Tire Badges
        TireBadge {
            x: 18px;
            y: 65px;
            wheel_name: "FL";
            pressure: root.fl_pressure;
            temperature: root.fl_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }

        TireBadge {
            x: parent.width - self.width - 18px;
            y: 65px;
            wheel_name: "FR";
            pressure: root.fr_pressure;
            temperature: root.fr_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }

        TireBadge {
            x: 18px;
            y: 250px;
            wheel_name: "RL";
            pressure: root.rl_pressure;
            temperature: root.rl_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }

        TireBadge {
            x: parent.width - self.width - 18px;
            y: 250px;
            wheel_name: "RR";
            pressure: root.rr_pressure;
            temperature: root.rr_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }
    }

    // VIEW 2: DYNAMIC SPEED WAVEFORM CHART & STATUS
    if !root.tpms_enabled: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;

        // ==========================================
        // 1. DYNAMIC SPEED WAVEFORM CHART
        // ==========================================
        Rectangle {
            x: 20px;
            y: 80px;
            width: 370px;
            height: 220px;
            background: #000000;

            // A very soft area shadow gives the line depth without becoming a
            // solid filled graph.
            Path {
                x: 0px;
                y: 0px;
                width: 370px;
                height: 220px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 370;
                viewbox-height: 220;
                stroke: transparent;
                stroke-width: 0px;
                fill: #ff1e380e;
                commands: root.chart_area_path;
            }

            Path {
                x: 0px;
                y: 0px;
                width: 370px;
                height: 220px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 370;
                viewbox-height: 220;
                stroke: #ff1e381a;
                stroke-width: 18px;
                stroke-line-cap: round;
                fill: transparent;
                commands: root.chart_stroke_path;
            }

            // Soft outer red glow for the outline only.
            Path {
                x: 0px;
                y: 0px;
                width: 370px;
                height: 220px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 370;
                viewbox-height: 220;
                stroke: #ff1d3844;
                stroke-width: 9px;
                stroke-line-cap: round;
                fill: transparent;
                commands: root.chart_stroke_path;
            }

            // Core Neon Red Curve Stroke (Thick, vibrant, smooth)
            Path {
                x: 0px;
                y: 0px;
                width: 370px;
                height: 220px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 370;
                viewbox-height: 220;
                stroke: #ff1e38;
                stroke-width: 3px;
                stroke-line-cap: round;
                fill: transparent;
                commands: root.chart_stroke_path;
            }

            if root.chart_endpoint_visible: Rectangle {
                // The live marker is anchored to the right edge: it represents
                // the newest sample, never the historical peak.
                x: (root.chart_endpoint_x - 5.5) * 1px;
                y: (root.chart_endpoint_y - 5.5) * 1px;
                width: 11px;
                height: 11px;
                border-radius: 5.5px;
                background: #000000;
                border-width: 2px;
                border-color: #ff1e38;

                Rectangle {
                    x: (parent.width - 4px) / 2;
                    y: (parent.height - 4px) / 2;
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: #ff1e38;
                }
            }
        }

        // =========================================================================
        // 2. STATUS ROW (COMPACT, CLOSE TOGETHER, TUCKED AT BOTTOM-RIGHT OF CHART)
        // =========================================================================

        // Header Title
        HorizontalLayout {
            x: 20px;
            y: 300px;
            width: 370px;
            height: 20px;

            Text {
                text: round(root.speed) + " KM/H";
                font-size: 13px;
                font-weight: 800;
                color: #ff2238;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            x: 20px;
            y: 300px;
            width: 370px;
            height: 18px;
            alignment: end;
            spacing: 14px;

            // GPS Status (Dot + Text compact and strictly inline)
            HorizontalLayout {
                spacing: 5px;
                alignment: center;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: root.gps_connected ? #ffffff : #55555b;
                }

                Text {
                    text: root.gps_connected ? "GPS" : "GPS";
                    font-size: 10px;
                    font-weight: 600;
                    color: root.gps_connected ? #ffffff : #6e6e78;
                    vertical-alignment: center;
                }
            }
        }
    }
}
