import { TireBadge, CarChassis } from "tpms.slint";
import { MapEmbed, Tile } from "@mapping/map.slint";

export component TpmsPanel inherits Rectangle {
    in property <bool> tpms_enabled;
    in property <float> fl_pressure;
    in property <float> fr_pressure;
    in property <float> rl_pressure;
    in property <float> rr_pressure;
    in property <float> fl_temp;
    in property <float> fr_temp;
    in property <float> rl_temp;
    in property <float> rr_temp;
    in property <float> alert_pressure;
    in property <float> alert_temp;
    in property <bool> gps_connected;
    in-out property <float> map_latitude;
    in-out property <float> map_longitude;
    in-out property <float> map_zoom;
    in property <bool> map_following;
    in property <[Tile]> map_tiles;
    in property <bool> map_tiles_available;
    callback map_pan(length, length);
    callback map_zoom_by(float, length, length);
    callback map_follow();
    width: 410px;
    height: 480px;
    background: #000000;

    if root.tpms_enabled: Rectangle {
                // Header
                Text {
            x: 20px;
            y: 16px;
            text: "TIRE PRESSURE TELEMETRY";
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: #64748b;
        }

        // Center Car Graphic
                CarChassis {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + 10px;
        }

        // 4 Tire Badges
                // Front Left
                TireBadge {
            x: 18px;
            y: 65px;
            wheel_name: "FL";
            pressure: root.fl_pressure;
            temperature: root.fl_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }
                // Front Right
                TireBadge {
            x: parent.width - self.width - 18px;
            y: 65px;
            wheel_name: "FR";
            pressure: root.fr_pressure;
            temperature: root.fr_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }
                // Rear Left
                TireBadge {
            x: 18px;
            y: 250px;
            wheel_name: "RL";
            pressure: root.rl_pressure;
            temperature: root.rl_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }
                // Rear Right
                TireBadge {
            x: parent.width - self.width - 18px;
            y: 250px;
            wheel_name: "RR";
            pressure: root.rr_pressure;
            temperature: root.rr_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }
    }

    if !root.tpms_enabled: Rectangle {
        MapEmbed {
            x: 14px;
            y: 24px;
            width: 382px;
            height: 396px;
            latitude <=> root.map_latitude;
            longitude <=> root.map_longitude;
            zoom <=> root.map_zoom;
            tiles: root.map_tiles;
        }

        // Vehicle GPS position marker (permanently centered)
                Rectangle {
            x: 194px;
            y: 211px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: #06b6d422;
            border-width: 1px;
            border-color: #06b6d466;

            Rectangle {
                x: 4px;
                y: 4px;
                width: 14px;
                height: 14px;
                background: #06b6d4;
                border-radius: 7px;
                border-width: 2px;
                border-color: #ffffff;
            }
        }
    }
}
