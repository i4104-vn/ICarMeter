import { TireBadge, CarChassis } from "tpms.slint";

export component TpmsPanel inherits Rectangle {
    in property <bool> tpms_enabled;
    in property <float> fl_pressure;
    in property <float> fr_pressure;
    in property <float> rl_pressure;
    in property <float> rr_pressure;
    in property <float> fl_temp;
    in property <float> fr_temp;
    in property <float> rl_temp;
    in property <float> rr_temp;
    in property <float> alert_pressure;
    in property <float> alert_temp;
    in property <bool> gps_connected;
    in property <bool> bt_active: true;
    in property <string> bt_device_name: "Bluetooth";

    // Dynamic Waveform Chart Properties
    in property <float> current_accel: 0.0;
    in property <string> chart_stroke_path: "M 0 160 C 30 160, 45 120, 65 120 C 85 120, 110 165, 130 165 C 158 165, 175 50, 200 50 C 225 50, 245 135, 260 135 C 280 135, 300 30, 320 30 C 342 30, 355 90, 370 100";
    in property <string> chart_fill_path: "M 0 160 C 30 160, 45 120, 65 120 C 85 120, 110 165, 130 165 C 158 165, 175 50, 200 50 C 225 50, 245 135, 260 135 C 280 135, 300 30, 320 30 C 342 30, 355 90, 370 100 L 370 220 L 0 220 Z";
    in property <float> chart_peak_x: 200.0;
    in property <float> chart_peak_y: 50.0;

    callback toggle_mode();

    width: 410px;
    height: 480px;
    background: #000000;

    // VIEW 1: TPMS TIRE TELEMETRY
    if root.tpms_enabled: Rectangle {
        // Header
        Text {
            x: 20px;
            y: 16px;
            text: "TIRE PRESSURE TELEMETRY";
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: #64748b;
        }

        // Center Car Graphic
        CarChassis {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + 10px;
        }

        // 4 Tire Badges
        TireBadge {
            x: 18px;
            y: 65px;
            wheel_name: "FL";
            pressure: root.fl_pressure;
            temperature: root.fl_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }
        TireBadge {
            x: parent.width - self.width - 18px;
            y: 65px;
            wheel_name: "FR";
            pressure: root.fr_pressure;
            temperature: root.fr_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }
        TireBadge {
            x: 18px;
            y: 250px;
            wheel_name: "RL";
            pressure: root.rl_pressure;
            temperature: root.rl_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }
        TireBadge {
            x: parent.width - self.width - 18px;
            y: 250px;
            wheel_name: "RR";
            pressure: root.rr_pressure;
            temperature: root.rr_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }
    }

    // VIEW 2: ACCEL/DECEL CURVE CHART & STATUS (IDENTICAL APP BACKGROUND)
    if !root.tpms_enabled: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;

        // Header Title (Clean, no boxes)
        Text {
            x: 34px;
            y: 24px;
            text: "DYNAMICS TELEMETRY";
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: #64748b;
        }

        // ==========================================
        // 1. MAIN CURVE CHART (Pure Black Background)
        // ==========================================
        Rectangle {
            x: 20px;
            y: 75px;
            width: 370px;
            height: 250px;
            background: #000000;

            // Gradient Fill beneath the red curve (red fading down into #000000)
            Path {
                x: 0px;
                y: 0px;
                width: 370px;
                height: 240px;
                fill: @linear-gradient(180deg, #ff1d38bb 0%, #b91c1c55 35%, #7f1d1d18 70%, #00000000 100%);
                stroke: transparent;
                commands: root.chart_fill_path;
            }

            // Vertical Dashed Drop Lines matching reference image
            // 1. Left Hill Drop line (x = 65)
            for i in 15: Rectangle {
                x: 65px;
                y: 120px + i * 7px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff2e;
                visible: (self.y + self.height) <= 220px;
            }

            // 2. First Trough Drop line (x = 130)
            for i in 9: Rectangle {
                x: 130px;
                y: 165px + i * 7px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff2e;
                visible: (self.y + self.height) <= 220px;
            }

            // 3. Second Trough Drop line (x = 260)
            for i in 13: Rectangle {
                x: 260px;
                y: 135px + i * 7px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff2e;
                visible: (self.y + self.height) <= 220px;
            }

            // 4. Right Hill Drop line (x = 320)
            for i in 28: Rectangle {
                x: 320px;
                y: 30px + i * 7px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff2e;
                visible: (self.y + self.height) <= 220px;
            }

            // 5. Far Right End Drop line (x = 370)
            for i in 18: Rectangle {
                x: 369px;
                y: 100px + i * 7px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff2e;
                visible: (self.y + self.height) <= 220px;
            }

            // 6. Active Highlight Peak Drop Line (follows chart_peak_x and chart_peak_y)
            for i in 30: Rectangle {
                x: (root.chart_peak_x - 0.75) * 1px;
                y: (root.chart_peak_y + 10.0 + i * 6.5) * 1px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff55;
                visible: (self.y + self.height) <= 220px;
            }

            // Soft Outer Red Glow for the curve line
            Path {
                x: 0px;
                y: 0px;
                width: 370px;
                height: 240px;
                stroke: #ff1d3844;
                stroke-width: 9px;
                stroke-line-cap: round;
                fill: transparent;
                commands: root.chart_stroke_path;
            }

            // Core Neon Red Curve Stroke (Thick, vibrant, smooth)
            Path {
                x: 0px;
                y: 0px;
                width: 370px;
                height: 240px;
                stroke: #ff1e38;
                stroke-width: 3px;
                stroke-line-cap: round;
                fill: transparent;
                commands: root.chart_stroke_path;
            }

            // Prominent Target Marker Bead on the Peak (Exact Replica from Image)
            // Outer semi-transparent dark ring with silver/white border
            Rectangle {
                x: (root.chart_peak_x - 11.0) * 1px;
                y: (root.chart_peak_y - 11.0) * 1px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: #000000dd;
                border-width: 2px;
                border-color: #cbd5e1;

                // Inner solid white glowing center dot
                Rectangle {
                    x: (parent.width - 8px) / 2;
                    y: (parent.height - 8px) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: #ffffff;
                }
            }
        }

        // ========================================================
        // 2. STATUS ROW (EXACTLY MATCHING TRIPPANEL STYLE, NO BADGES)
        // ========================================================
        HorizontalLayout {
            x: 34px;
            y: 425px;
            width: 340px;
            height: 28px;
            spacing: 24px;

            // Bluetooth Status (Dot + Text)
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.bt_active ? #ffffff : #55555b;
                }
                Text {
                    text: root.bt_device_name;
                    font-size: 13px;
                    font-weight: 700;
                    color: root.bt_active ? #ffffff : #6e6e78;
                    vertical-alignment: center;
                }
            }

            // GPS Status (Dot + Text)
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.gps_connected ? #ffffff : #55555b;
                }
                Text {
                    text: root.gps_connected ? "GPS" : "GPS SEARCHING";
                    font-size: 13px;
                    font-weight: 700;
                    color: root.gps_connected ? #ffffff : #6e6e78;
                    vertical-alignment: center;
                }
            }
        }
    }
}
