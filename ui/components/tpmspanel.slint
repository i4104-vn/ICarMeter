import { TireBadge, CarChassis } from "tpms.slint";

export component TpmsPanel inherits Rectangle {
    in property <bool> tpms_enabled;
    in property <float> fl_pressure;
    in property <float> fr_pressure;
    in property <float> rl_pressure;
    in property <float> rr_pressure;
    in property <float> fl_temp;
    in property <float> fr_temp;
    in property <float> rl_temp;
    in property <float> rr_temp;
    in property <float> alert_pressure;
    in property <float> alert_temp;
    in property <bool> gps_connected;
    in property <bool> bt_active: true;
    in property <string> bt_device_name: "Bluetooth";

    // Dynamic Speed Waveform Chart Properties
    in property <float> speed: 0.0;
    in property <string> chart_stroke_path: "M 0 160 C 30 160, 45 120, 65 120 C 85 120, 110 165, 130 165 C 158 165, 175 50, 200 50 C 225 50, 245 135, 260 135 C 280 135, 300 30, 320 30 C 342 30, 355 90, 370 100";
    in property <string> chart_fill_path: "M 0 160 C 30 160, 45 120, 65 120 C 85 120, 110 165, 130 165 C 158 165, 175 50, 200 50 C 225 50, 245 135, 260 135 C 280 135, 300 30, 320 30 C 342 30, 355 90, 370 100 L 370 210 L 0 210 Z";
    in property <float> chart_peak_x: 200.0;
    in property <float> chart_peak_y: 50.0;
    in property <float> chart_y1: 120.0;
    in property <float> chart_y2: 165.0;
    in property <float> chart_y4: 135.0;
    in property <float> chart_y5: 30.0;
    in property <float> chart_y6: 100.0;

    callback toggle_mode();

    width: 410px;
    height: 480px;
    background: #000000;

    // VIEW 1: TPMS TIRE TELEMETRY
    if root.tpms_enabled: Rectangle {
        // Center Car Graphic
        CarChassis {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + 10px;
        }

        // 4 Tire Badges
        TireBadge {
            x: 18px;
            y: 65px;
            wheel_name: "FL";
            pressure: root.fl_pressure;
            temperature: root.fl_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }

        TireBadge {
            x: parent.width - self.width - 18px;
            y: 65px;
            wheel_name: "FR";
            pressure: root.fr_pressure;
            temperature: root.fr_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }

        TireBadge {
            x: 18px;
            y: 250px;
            wheel_name: "RL";
            pressure: root.rl_pressure;
            temperature: root.rl_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }

        TireBadge {
            x: parent.width - self.width - 18px;
            y: 250px;
            wheel_name: "RR";
            pressure: root.rr_pressure;
            temperature: root.rr_temp;
            alert_pressure: root.alert_pressure;
            alert_temp: root.alert_temp;
        }
    }

    // VIEW 2: DYNAMIC SPEED WAVEFORM CHART & STATUS
    if !root.tpms_enabled: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;

        // ==========================================
        // 1. DYNAMIC SPEED WAVEFORM CHART
        // ==========================================
        Rectangle {
            x: 20px;
            y: 80px;
            width: 370px;
            height: 220px;
            background: #000000;

            // Gradient Fill beneath the red curve (red fading down into #000000)
            Path {
                x: 0px;
                y: 0px;
                width: 370px;
                height: 220px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 370;
                viewbox-height: 220;
                fill: @linear-gradient(180deg, #ff1d38bb 0%, #b91c1c55 35%, #7f1d1d18 70%, #00000000 100%);
                stroke: transparent;
                commands: root.chart_fill_path;
            }

            // Vertical Dashed Drop Lines matching reference image
            // 1. Left Hill Drop line (x = 65)
            for i in 22: Rectangle {
                x: 65px;
                y: (root.chart_y1 + 4.0 + i * 6.5) * 1px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff2e;
                visible: (self.y + self.height) <= 210px;
            }

            // 2. First Trough Drop line (x = 130)
            for i in 15: Rectangle {
                x: 130px;
                y: (root.chart_y2 + 4.0 + i * 6.5) * 1px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff2e;
                visible: (self.y + self.height) <= 210px;
            }

            // 3. Second Trough Drop line (x = 260)
            for i in 18: Rectangle {
                x: 260px;
                y: (root.chart_y4 + 4.0 + i * 6.5) * 1px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff2e;
                visible: (self.y + self.height) <= 210px;
            }

            // 4. Right Hill Drop line (x = 320)
            for i in 28: Rectangle {
                x: 320px;
                y: (root.chart_y5 + 4.0 + i * 6.5) * 1px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff2e;
                visible: (self.y + self.height) <= 210px;
            }

            // 5. Far Right End Drop line (x = 370)
            for i in 20: Rectangle {
                x: 369px;
                y: (root.chart_y6 + 4.0 + i * 6.5) * 1px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff2e;
                visible: (self.y + self.height) <= 210px;
            }

            // 6. Active Highlight Peak Drop Line (follows chart_peak_x and chart_peak_y)
            for i in 30: Rectangle {
                x: (root.chart_peak_x - 0.75) * 1px;
                y: (root.chart_peak_y + 11.0 + i * 6.0) * 1px;
                width: 1.5px;
                height: 3.5px;
                background: #ffffff55;
                visible: (self.y + self.height) <= 210px;
            }

            // Soft Outer Red Glow for the curve line
            Path {
                x: 0px;
                y: 0px;
                width: 370px;
                height: 220px;
                stroke: #ff1d3844;
                stroke-width: 9px;
                stroke-line-cap: round;
                fill: transparent;
                commands: root.chart_stroke_path;
            }

            // Core Neon Red Curve Stroke (Thick, vibrant, smooth)
            Path {
                x: 0px;
                y: 0px;
                width: 370px;
                height: 220px;
                stroke: #ff1e38;
                stroke-width: 3px;
                stroke-line-cap: round;
                fill: transparent;
                commands: root.chart_stroke_path;
            }

            // Prominent Target Marker Bead on the Peak (Exact Replica from Image)
            // Outer semi-transparent dark ring with silver/white border
            Rectangle {
                x: (root.chart_peak_x - 11.0) * 1px;
                y: (root.chart_peak_y - 11.0) * 1px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: #000000dd;
                border-width: 2px;
                border-color: #cbd5e1;

                // Inner solid white glowing center dot
                Rectangle {
                    x: (parent.width - 8px) / 2;
                    y: (parent.height - 8px) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: #ffffff;
                }
            }
        }

        // =========================================================================
        // 2. STATUS ROW (COMPACT, CLOSE TOGETHER, TUCKED AT BOTTOM-RIGHT OF CHART)
        // =========================================================================

        // Header Title
        HorizontalLayout {
            x: 20px;
            y: 300px;
            width: 370px;
            height: 20px;

            Text {
                text: round(root.speed) + " KM/H";
                font-size: 13px;
                font-weight: 800;
                color: #ff2238;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            x: 20px;
            y: 300px;
            width: 370px;
            height: 18px;
            alignment: end;
            spacing: 14px;

            // Bluetooth Status (Dot + Text compact and strictly inline)
            HorizontalLayout {
                spacing: 5px;
                alignment: center;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: root.bt_active ? #ffffff : #55555b;
                }

                Text {
                    text: root.bt_device_name;
                    font-size: 10px;
                    font-weight: 600;
                    color: root.bt_active ? #ffffff : #6e6e78;
                    vertical-alignment: center;
                }
            }

            // GPS Status (Dot + Text compact and strictly inline)
            HorizontalLayout {
                spacing: 5px;
                alignment: center;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: root.gps_connected ? #ffffff : #55555b;
                }

                Text {
                    text: root.gps_connected ? "GPS" : "GPS";
                    font-size: 10px;
                    font-weight: 600;
                    color: root.gps_connected ? #ffffff : #6e6e78;
                    vertical-alignment: center;
                }
            }
        }
    }
}
