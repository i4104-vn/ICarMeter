import { EmoEyes } from "companion.slint";

export component SpeedPanel inherits Rectangle {
    in property <float> speed;
    in property <int> random_seed;

    property <float> bounded_speed: Math.max(0.0, Math.min(root.speed, 100.0));
    property <float> fill_progress: root.smooth-step(root.bounded_speed / 100.0);
    property <int> particle_count: Math.round(18.0 + root.bounded_speed * 0.3);

    function smooth-step(value: float) -> float {
        let t = Math.max(0.0, Math.min(value, 1.0));
        return t * t * (3.0 - 2.0 * t);
    }

    // The original speedometer palette: icy silver -> cyan -> amber -> coral.
    property <color> speed_color: root.bounded_speed < 42.0
        ? #dcebF2.mix(#4adeD8, root.smooth-step(root.bounded_speed / 42.0))
        : (root.bounded_speed < 72.0
        ? #4adeD8.mix(#ffc15c, root.smooth-step((root.bounded_speed - 42.0) / 30.0))
        : #ffc15c.mix(#ff565c, root.smooth-step((root.bounded_speed - 72.0) / 28.0)));

    width: 460px;
    height: 480px;
    background: #000000;

    property <float> particle_tick: 0.0;

    Timer {
        interval: 16ms;
        running: emo.gps_screen;
        triggered => {
            // Rate of particle travel accelerates with vehicle speed
            let speed_mult = 0.016 * (0.28 + root.bounded_speed * 0.012);
            root.particle_tick = Math.mod(root.particle_tick + speed_mult, 1.0);
        }
    }

    // Shortened bracket geometry:
    // Left: P0=(135, 330), P1=(55, 290), P2=(55, 190), P3=(135, 150)
    // Right: P0=(325, 330), P1=(405, 290), P2=(405, 190), P3=(325, 150)
    // De Casteljau subdivision trims cubic Bezier from bottom (t=0) to progress (t=p)
    function lerp(a: float, b: float, t: float) -> float {
        return a + (b - a) * t;
    }

    function tip-qx(p: float) -> float {
        let q1x = root.lerp(135.0, 55.0, p);
        let r0x = 55.0;
        let r1x = root.lerp(55.0, 135.0, p);
        let q2x = root.lerp(q1x, r0x, p);
        let s0x = root.lerp(r0x, r1x, p);
        return root.lerp(q2x, s0x, p);
    }

    function tip-qy(p: float) -> float {
        let q1y = root.lerp(330.0, 290.0, p);
        let r0y = root.lerp(290.0, 190.0, p);
        let r1y = root.lerp(190.0, 150.0, p);
        let q2y = root.lerp(q1y, r0y, p);
        let s0y = root.lerp(r0y, r1y, p);
        return root.lerp(q2y, s0y, p);
    }

    function active-fill-path(p: float) -> string {
        let q1x = root.lerp(135.0, 55.0, p);
        let q1y = root.lerp(330.0, 290.0, p);
        let r0x = 55.0;
        let r0y = root.lerp(290.0, 190.0, p);
        let r1x = root.lerp(55.0, 135.0, p);
        let r1y = root.lerp(190.0, 150.0, p);
        let q2x = root.lerp(q1x, r0x, p);
        let q2y = root.lerp(q1y, r0y, p);
        let s0x = root.lerp(r0x, r1x, p);
        let s0y = root.lerp(r0y, r1y, p);
        let q3x = root.lerp(q2x, s0x, p);
        let q3y = root.lerp(q2y, s0y, p);

        let rq1x = 460.0 - q1x;
        let rq2x = 460.0 - q2x;
        let rq3x = 460.0 - q3x;

        return "M 135 330 C " + Math.round(q1x) + " " + Math.round(q1y)
            + " " + Math.round(q2x) + " " + Math.round(q2y)
            + " " + Math.round(q3x) + " " + Math.round(q3y)
            + " M 325 330 C " + Math.round(rq1x) + " " + Math.round(q1y)
            + " " + Math.round(rq2x) + " " + Math.round(q2y)
            + " " + Math.round(rq3x) + " " + Math.round(q3y);
    }

    // Coprime pseudo-random generator for uniform, portable distribution across all renderers
    function particle-is-right(i: int) -> bool {
        return Math.mod(i, 2) == 1;
    }

    function r1(i: int) -> float {
        return Math.mod(i * 17 + 5, 23) / 23.0;
    }

    function r2(i: int) -> float {
        return Math.mod(i * 31 + 11, 29) / 29.0;
    }

    function r3(i: int) -> float {
        return Math.mod(i * 43 + 7, 37) / 37.0;
    }

    function r4(i: int) -> float {
        return Math.mod(i * 59 + 13, 41) / 41.0;
    }

    function particle-x-start(i: int) -> float {
        return root.particle-is-right(i)
            ? (430.0 - root.r1(i) * 100.0)
            : (30.0 + root.r1(i) * 100.0);
    }

    function particle-x-end(i: int) -> float {
        return root.particle-is-right(i)
            ? (325.0 - root.r2(i) * 45.0)
            : (135.0 + root.r2(i) * 45.0);
    }

    function particle-y-start(i: int) -> float {
        return 90.0 + root.r3(i) * 300.0;
    }

    function particle-y-drift(i: int) -> float {
        return (root.r4(i) - 0.5) * 50.0;
    }

    function particle-speed-factor(i: int) -> float {
        return 0.65 + root.r4(i) * 0.70;
    }

    function particle-initial-phase(i: int) -> float {
        return Math.mod(root.r2(i) * 0.618 + root.r1(i) * 0.382, 1.0);
    }

    function particle-radius(i: int) -> length {
        return (1.3 + root.r3(i) * 1.7) * 1px;
    }

    function particle-progress(i: int) -> float {
        let sf = root.particle-speed-factor(i);
        let ip = root.particle-initial-phase(i);
        return Math.mod(root.particle_tick * sf + ip, 1.0);
    }

    function particle-x(i: int) -> float {
        let p = root.particle-progress(i);
        let travel = p * (2.0 - p);
        let x0 = root.particle-x-start(i);
        let x1 = root.particle-x-end(i);
        return x0 + (x1 - x0) * travel;
    }

    function particle-y(i: int) -> float {
        let p = root.particle-progress(i);
        let y0 = root.particle-y-start(i);
        let dy = root.particle-y-drift(i);
        return y0 + dy * p;
    }

    function particle-opacity(i: int) -> float {
        let p = root.particle-progress(i);
        let x = root.particle-x(i);
        let y = root.particle-y(i);

        // Smooth fade-in, sustain, and fade-out near target
        let life_fade = p < 0.20
            ? (p / 0.20)
            : (p < 0.75
            ? 1.0
            : Math.max(0.0, (1.0 - p) / 0.25));

        // Edge fade near side dividers
        let edge_fade = x < 24.0
            ? Math.max(0.0, Math.min(1.0, (x - 6.0) / 18.0))
            : (x > 436.0
            ? Math.max(0.0, Math.min(1.0, (454.0 - x) / 18.0))
            : 1.0);

        // Clear center digit zone
        let digit_dx = (x - 230.0) / 88.0;
        let digit_dy = (y - 235.0) / 95.0;
        let digit_clear = digit_dx * digit_dx + digit_dy * digit_dy < 1.0 ? 0.0 : 1.0;

        return life_fade * edge_fade * digit_clear;
    }

    if emo.gps_screen: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000;

        // Shortened speedometer brackets: quiet track plus a soft outer glow.
        Path {
            width: 460px;
            height: 480px;
            stroke: #46525c1a;
            stroke-width: 15px;
            stroke-line-cap: round;
            fill: transparent;
            commands: "M 135 330 C 55 290 55 190 135 150 M 325 330 C 405 290 405 190 325 150";
        }

        Path {
            width: 460px;
            height: 480px;
            stroke: #2a323a9e;
            stroke-width: 5px;
            stroke-line-cap: round;
            fill: transparent;
            commands: "M 135 330 C 55 290 55 190 135 150 M 325 330 C 405 290 405 190 325 150";
        }

        // Active progressive stroke filling directly from bottom to top along the curve
        if root.fill_progress > 0.005: Path {
            width: 460px;
            height: 480px;
            stroke: root.speed_color.transparentize(84%);
            stroke-width: 24px;
            stroke-line-cap: round;
            fill: transparent;
            commands: root.active-fill-path(root.fill_progress);
        }

        if root.fill_progress > 0.005: Path {
            width: 460px;
            height: 480px;
            stroke: root.speed_color.transparentize(68%);
            stroke-width: 12px;
            stroke-line-cap: round;
            fill: transparent;
            commands: root.active-fill-path(root.fill_progress);
        }

        if root.fill_progress > 0.005: Path {
            width: 460px;
            height: 480px;
            stroke: root.speed_color;
            stroke-width: 6.5px;
            stroke-line-cap: round;
            fill: transparent;
            commands: root.active-fill-path(root.fill_progress);
        }

        // Leading tip glowing beads gliding at the exact front of the active fill
        if root.fill_progress > 0.01: Rectangle {
            x: root.tip-qx(root.fill_progress) * 1px - 7px;
            y: root.tip-qy(root.fill_progress) * 1px - 7px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.speed_color.transparentize(65%);
        }
        if root.fill_progress > 0.01: Rectangle {
            x: root.tip-qx(root.fill_progress) * 1px - 4px;
            y: root.tip-qy(root.fill_progress) * 1px - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.speed_color;
        }

        if root.fill_progress > 0.01: Rectangle {
            x: (460.0 - root.tip-qx(root.fill_progress)) * 1px - 7px;
            y: root.tip-qy(root.fill_progress) * 1px - 7px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.speed_color.transparentize(65%);
        }
        if root.fill_progress > 0.01: Rectangle {
            x: (460.0 - root.tip-qx(root.fill_progress)) * 1px - 4px;
            y: root.tip-qy(root.fill_progress) * 1px - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.speed_color;
        }

        // Random energy suction particles (no circular formation)
        for i in 48: Rectangle {
            visible: i < root.particle_count && root.particle-opacity(i) > 0.01;
            x: root.particle-x(i) * 1px - root.particle-radius(i);
            y: root.particle-y(i) * 1px - root.particle-radius(i);
            width: root.particle-radius(i) * 2;
            height: root.particle-radius(i) * 2;
            border-radius: root.particle-radius(i);
            background: root.speed_color;
            opacity: root.particle-opacity(i);
        }

        Text {
            x: 0px;
            y: 118px;
            width: 460px;
            height: 190px;
            text: Math.round(root.speed);
            font-size: 156px;
            font-weight: 900;
            color: root.speed_color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    emo := EmoEyes {
        x: Math.round((parent.width - self.width) / 2px) * 1px;
        y: Math.round((parent.height - self.height) / 2px) * 1px;
        speed: root.speed;
        random_seed: root.random_seed;
        enabled: true;
        visible: !self.gps_screen;
    }
}

