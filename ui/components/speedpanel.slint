import { EmoEyes } from "companion.slint";

export component SpeedPanel inherits Rectangle {
    in property <float> speed;
    in property <int> random_seed;
    in property <bool> show_bt_log;
    in property <string> latest_bt_log;

    property <float> bounded_speed: Math.max(0.0, Math.min(root.speed, 100.0));
    property <float> fill_progress: root.bounded_speed / 100.0;
    // Speed scale: white -> blue -> yellow -> red.
    property <color> speed_color: root.bounded_speed < 35.0
        ? #ffffff.mix(#3b82f6, root.bounded_speed / 35.0)
        : (root.bounded_speed < 70.0
        ? #3b82f6.mix(#facc15, (root.bounded_speed - 35.0) / 35.0)
        : #facc15.mix(#ef4444, (root.bounded_speed - 70.0) / 30.0));

    width: 460px;
    height: 480px;
    background: #000000;

    property <float> particle_tick: 0.0;

    Timer {
        interval: 16ms;
        running: emo.gps_screen;
        triggered => {
            let speed_mult = 0.007 + root.fill_progress * 0.015;
            root.particle_tick = Math.mod(root.particle_tick + speed_mult, 1.0);
        }
    }

    function bracket-pos-x(t: float, right: bool) -> length {
        let u = 1.0 - t;
        // Keep both brackets comfortably inside the center panel so the
        // glow/particles do not visually touch the column dividers.
        let left_x = u * u * u * 142.0 + 3.0 * u * u * t * 66.0
            + 3.0 * u * t * t * 66.0 + t * t * t * 142.0;
        return (right ? 460.0 - left_x : left_x) * 1px;
    }

    function bracket-pos-y(t: float) -> length {
        let u = 1.0 - t;
        return (u * u * u * 348.0 + 3.0 * u * u * t * 305.0
            + 3.0 * u * t * t * 175.0 + t * t * t * 132.0) * 1px;
    }

    function particle-x(i: int) -> length {
        let is_right = i >= 14;
        let idx = is_right ? (i - 14) : i;
        let p_phase = Math.mod(root.particle_tick + idx * 0.0714 + (is_right ? 0.035 : 0.0), 1.0);
        let ease = p_phase * p_phase;
        if is_right {
            let x_start = 378.0 + (idx == 0 || idx == 7 ? 12.0 : (idx == 3 || idx == 10 ? -12.0 : 0.0));
            let x_end = 335.0;
            return (x_start - (x_start - x_end) * ease) * 1px;
        } else {
            let x_start = 82.0 + (idx == 0 || idx == 7 ? -12.0 : (idx == 3 || idx == 10 ? 12.0 : 0.0));
            let x_end = 125.0;
            return (x_start + (x_end - x_start) * ease) * 1px;
        }
    }

    function particle-y(i: int) -> length {
        let is_right = i >= 14;
        let idx = is_right ? (i - 14) : i;
        let p_phase = Math.mod(root.particle_tick + idx * 0.0714 + (is_right ? 0.035 : 0.0), 1.0);
        let y_start = 128.0 + idx * 13.5;
        let y_end = 215.0;
        return (y_start + (y_end - y_start) * p_phase * 0.6) * 1px;
    }

    function particle-opacity(i: int) -> float {
        let is_right = i >= 14;
        let idx = is_right ? (i - 14) : i;
        let p_phase = Math.mod(root.particle_tick + idx * 0.0714 + (is_right ? 0.035 : 0.0), 1.0);
        let alpha = p_phase < 0.2
            ? (p_phase / 0.2)
            : (p_phase < 0.62
            ? 1.0
            : Math.max(0.0, (0.92 - p_phase) / 0.3));
        return alpha;
    }

    function particle-color(i: int) -> color {
        let is_right = i >= 14;
        let idx = is_right ? (i - 14) : i;
        let p_phase = Math.mod(root.particle_tick + idx * 0.0714 + (is_right ? 0.035 : 0.0), 1.0);
        // Particle core blends from bright spark into vibrant speed_color
        return #ffffff.mix(root.speed_color, Math.min(1.0, p_phase * 1.5));
    }

    function particle-glow(i: int) -> color {
        return root.speed_color.transparentize(65%);
    }

    function particle-w(i: int) -> length {
        let idx = Math.mod(i, 4);
        return (idx == 0 ? 7.0 : (idx == 1 ? 5.0 : (idx == 2 ? 6.0 : 4.0))) * 1px;
    }

    function particle-h(i: int) -> length {
        let idx = Math.mod(i, 4);
        return (idx == 0 ? 3.0 : (idx == 1 ? 3.0 : (idx == 2 ? 4.0 : 2.5))) * 1px;
    }

    if root.show_bt_log: VerticalLayout {
        padding: 24px;
        spacing: 14px;

        Text {
            text: "BLUETOOTH CONSOLE · [B] TO CLOSE";
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: #38bdf8;
        }

        Text {
            text: root.latest_bt_log;
            font-size: 12px;
            font-family: "monospace";
            color: #a5f3fc;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }

    if !root.show_bt_log && emo.gps_screen: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000;

        // Smooth background curved brackets (pulled slightly inward from the
        // panel edges, continuous vector path, no dots).
        Path {
            width: 460px;
            height: 480px;
            stroke: #262930;
            stroke-width: 5px;
            stroke-line-cap: round;
            fill: transparent;
            commands: "M 142 132 C 66 175 66 305 142 348 M 318 132 C 394 175 394 305 318 348";
        }

        // Smooth active color fill advancing from bottom to top
        if root.fill_progress > 0.005: Rectangle {
            x: 0px;
            y: (348.0 - 216.0 * root.fill_progress - 6.0) * 1px;
            width: 460px;
            height: (216.0 * root.fill_progress + 14.0) * 1px;
            clip: true;

            // Outer glow path
            Path {
                x: 0px;
                y: -(348.0 - 216.0 * root.fill_progress - 6.0) * 1px;
                width: 460px;
                height: 480px;
                stroke: root.speed_color.transparentize(72%);
                stroke-width: 14px;
                stroke-line-cap: round;
                fill: transparent;
                commands: "M 142 132 C 66 175 66 305 142 348 M 318 132 C 394 175 394 305 318 348";
            }

            // Core solid active stroke
            Path {
                x: 0px;
                y: -(348.0 - 216.0 * root.fill_progress - 6.0) * 1px;
                width: 460px;
                height: 480px;
                stroke: root.speed_color;
                stroke-width: 5px;
                stroke-line-cap: round;
                fill: transparent;
                commands: "M 142 132 C 66 175 66 305 142 348 M 318 132 C 394 175 394 305 318 348";
            }
        }

        // Leading tip glowing beads gliding along the curves
        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, false) - 7px;
            y: root.bracket-pos-y(root.fill_progress) - 7px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.speed_color.transparentize(65%);
        }
        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, false) - 4px;
            y: root.bracket-pos-y(root.fill_progress) - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.speed_color;
        }

        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, true) - 7px;
            y: root.bracket-pos-y(root.fill_progress) - 7px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.speed_color.transparentize(65%);
        }
        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, true) - 4px;
            y: root.bracket-pos-y(root.fill_progress) - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.speed_color;
        }

        // Energy particles sucked towards the digits, fading out before touching the numbers
        for i in 28: Rectangle {
            visible: root.particle-opacity(i) > 0.01;
            x: root.particle-x(i) - 2px;
            y: root.particle-y(i) - 2px;
            width: root.particle-w(i) + 4px;
            height: root.particle-h(i) + 4px;
            border-radius: (root.particle-h(i) + 4px) / 2;
            background: root.particle-glow(i);
            opacity: root.particle-opacity(i);
        }
        for i in 28: Rectangle {
            visible: root.particle-opacity(i) > 0.01;
            x: root.particle-x(i);
            y: root.particle-y(i);
            width: root.particle-w(i);
            height: root.particle-h(i);
            border-radius: root.particle-h(i) / 2;
            background: root.particle-color(i);
            opacity: root.particle-opacity(i);
        }

        Text {
            x: 100px;
            y: 118px;
            width: 260px;
            height: 190px;
            text: Math.round(root.speed);
            font-size: 156px;
            font-weight: 900;
            color: root.speed_color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            x: 150px;
            y: 304px;
            width: 160px;
            text: "km/h";
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: #a0a0a5;
            horizontal-alignment: center;
        }
    }

    emo := EmoEyes {
        x: Math.round((parent.width - self.width) / 2px) * 1px;
        y: Math.round((parent.height - self.height) / 2px) * 1px;
        speed: root.speed;
        random_seed: root.random_seed;
        enabled: !root.show_bt_log;
        visible: !root.show_bt_log && !self.gps_screen;
    }
}
