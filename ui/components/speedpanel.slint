import { EmoEyes } from "companion.slint";

export component SpeedPanel inherits Rectangle {
    in property <float> speed;
    in property <int> random_seed;
    in property <bool> show_bt_log;
    in property <string> latest_bt_log;

    property <float> bounded_speed: Math.max(0.0, Math.min(root.speed, 100.0));
    property <float> fill_progress: root.smooth-step(root.bounded_speed / 100.0);
    property <int> particle_count: Math.round(30.0 + root.bounded_speed * 1.25);

    function smooth-step(value: float) -> float {
        let t = Math.max(0.0, Math.min(value, 1.0));
        return t * t * (3.0 - 2.0 * t);
    }

    // The original speedometer palette: icy silver -> cyan -> amber -> coral.
    property <color> speed_color: root.bounded_speed < 42.0
        ? #dcebF2.mix(#4adeD8, root.smooth-step(root.bounded_speed / 42.0))
        : (root.bounded_speed < 72.0
        ? #4adeD8.mix(#ffc15c, root.smooth-step((root.bounded_speed - 42.0) / 30.0))
        : #ffc15c.mix(#ff565c, root.smooth-step((root.bounded_speed - 72.0) / 28.0)));

    width: 460px;
    height: 480px;
    background: #000000;

    property <float> particle_tick: 0.0;

    Timer {
        interval: 16ms;
        running: emo.gps_screen;
        triggered => {
            // Match the original particle engine: inward speed is
            // 15 + (GPS speed * 1.85) pixels per second over a 135px span.
            let speed_mult = 0.016 * (15.0 + root.bounded_speed * 1.85) / 135.0;
            root.particle_tick = Math.mod(root.particle_tick + speed_mult, 1.0);
        }
    }

    function bracket-pos-x(t: float, right: bool) -> length {
        let u = 1.0 - t;
        let left_x = u * u * u * 120.0 + 3.0 * u * u * t * 40.0
            + 3.0 * u * t * t * 40.0 + t * t * t * 120.0;
        return (right ? 460.0 - left_x : left_x) * 1px;
    }

    function bracket-pos-y(t: float) -> length {
        let u = 1.0 - t;
        return (u * u * u * 348.0 + 3.0 * u * u * t * 305.0
            + 3.0 * u * t * t * 175.0 + t * t * t * 132.0) * 1px;
    }

    function particle-seed(i: int) -> float {
        return Math.abs(Math.sin(i * 19.17 * 1deg));
    }

    function particle-angle(i: int) -> angle {
        return ((i / 180.0) * 360.0 + root.particle-seed(i) * 28.6479) * 1deg;
    }

    function particle-distance(i: int) -> float {
        let speed_factor = 0.75 + root.particle-seed(i) * 0.55;
        let phase = Math.mod(root.particle_tick * speed_factor + root.particle-seed(i) * 0.47, 1.0);
        // The old engine moved from its outer radius toward the terminal
        // radius, then respawned outside with a deterministic offset.
        return 96.0 + (1.0 - phase) * 135.0;
    }

    function particle-x-value(i: int) -> float {
        return 230.0 + Math.cos(root.particle-angle(i)) * root.particle-distance(i);
    }

    function particle-y-value(i: int) -> float {
        return 240.0 + Math.sin(root.particle-angle(i)) * root.particle-distance(i) * 0.78;
    }

    function particle-x(i: int) -> length {
        return root.particle-x-value(i) * 1px;
    }

    function particle-y(i: int) -> length {
        return root.particle-y-value(i) * 1px;
    }

    function particle-opacity(i: int) -> float {
        let x = root.particle-x-value(i);
        let y = root.particle-y-value(i);
        let dist = root.particle-distance(i);
        let edge_fade = x < 26.0
            ? Math.max(0.0, Math.min(1.0, (x - 6.0) / 20.0))
            : (x > 434.0
            ? Math.max(0.0, Math.min(1.0, (454.0 - x) / 20.0))
            : 1.0);
        let digit_dx = (x - 230.0) / 92.0;
        let digit_dy = (y - 248.0) / 106.0;
        let digit_clear = digit_dx * digit_dx + digit_dy * digit_dy < 1.0 ? 0.0 : 1.0;
        let inner_fade = Math.max(0.0, Math.min(1.0, (dist - 96.0) / 28.0));
        return edge_fade * digit_clear * inner_fade;
    }

    function particle-size(i: int) -> length {
        return (1.4 + root.particle-seed(i) * 2.2) * 1px;
    }

    if root.show_bt_log: VerticalLayout {
        padding: 24px;
        spacing: 14px;

        Text {
            text: "BLUETOOTH CONSOLE · [B] TO CLOSE";
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: #38bdf8;
        }

        Text {
            text: root.latest_bt_log;
            font-size: 12px;
            font-family: "monospace";
            color: #a5f3fc;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }

    if !root.show_bt_log && emo.gps_screen: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000;

        // Original speedometer brackets: quiet track plus a soft outer glow.
        Path {
            width: 460px;
            height: 480px;
            stroke: #46525c1a;
            stroke-width: 15px;
            stroke-line-cap: round;
            fill: transparent;
            commands: "M 120 348 C 40 305 40 175 120 132 M 340 348 C 420 305 420 175 340 132";
        }

        Path {
            width: 460px;
            height: 480px;
            stroke: #2a323a9e;
            stroke-width: 5px;
            stroke-line-cap: round;
            fill: transparent;
            commands: "M 120 348 C 40 305 40 175 120 132 M 340 348 C 420 305 420 175 340 132";
        }

        // Reveal the original active bracket stroke from bottom to top.
        if root.fill_progress > 0.005: Rectangle {
            x: 0px;
            y: (348.0 - 216.0 * root.fill_progress - 12.0) * 1px;
            width: 460px;
            height: (216.0 * root.fill_progress + 24.0) * 1px;
            clip: true;

            // Original active soft screen glow.
            Path {
                x: 0px;
                y: -(348.0 - 216.0 * root.fill_progress - 12.0) * 1px;
                width: 460px;
                height: 480px;
                stroke: root.speed_color.transparentize(84%);
                stroke-width: 24px;
                stroke-line-cap: round;
                fill: transparent;
                commands: "M 120 348 C 40 305 40 175 120 132 M 340 348 C 420 305 420 175 340 132";
            }

            Path {
                x: 0px;
                y: -(348.0 - 216.0 * root.fill_progress - 12.0) * 1px;
                width: 460px;
                height: 480px;
                stroke: root.speed_color.transparentize(68%);
                stroke-width: 12px;
                stroke-line-cap: round;
                fill: transparent;
                commands: "M 120 348 C 40 305 40 175 120 132 M 340 348 C 420 305 420 175 340 132";
            }

            // Original bright active core.
            Path {
                x: 0px;
                y: -(348.0 - 216.0 * root.fill_progress - 12.0) * 1px;
                width: 460px;
                height: 480px;
                stroke: root.speed_color;
                stroke-width: 6.5px;
                stroke-line-cap: round;
                fill: transparent;
                commands: "M 120 348 C 40 305 40 175 120 132 M 340 348 C 420 305 420 175 340 132";
            }
        }

        // Leading tip glowing beads gliding along the curves
        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, false) - 7px;
            y: root.bracket-pos-y(root.fill_progress) - 7px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.speed_color.transparentize(65%);
        }
        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, false) - 4px;
            y: root.bracket-pos-y(root.fill_progress) - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.speed_color;
        }

        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, true) - 7px;
            y: root.bracket-pos-y(root.fill_progress) - 7px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.speed_color.transparentize(65%);
        }
        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, true) - 4px;
            y: root.bracket-pos-y(root.fill_progress) - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.speed_color;
        }

        // Original radial suction dots: clean circles, no tails or glow layer.
        for i in 180: Rectangle {
            visible: i < root.particle_count && root.particle-opacity(i) > 0.01;
            x: root.particle-x(i);
            y: root.particle-y(i);
            width: root.particle-size(i) * 2;
            height: root.particle-size(i) * 2;
            border-radius: root.particle-size(i);
            background: root.speed_color;
            opacity: root.particle-opacity(i);
        }

        Text {
            x: 0px;
            y: 118px;
            width: 460px;
            height: 190px;
            text: Math.round(root.speed);
            font-size: 156px;
            font-weight: 900;
            color: root.speed_color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    emo := EmoEyes {
        x: Math.round((parent.width - self.width) / 2px) * 1px;
        y: Math.round((parent.height - self.height) / 2px) * 1px;
        speed: root.speed;
        random_seed: root.random_seed;
        enabled: !root.show_bt_log;
        visible: !root.show_bt_log && !self.gps_screen;
    }
}
