import { EmoEyes } from "companion.slint";

export component SpeedPanel inherits Rectangle {
    in property <float> speed;
    in property <int> random_seed;
    in property <bool> show_bt_log;
    in property <string> latest_bt_log;

    property <float> bounded_speed: Math.max(0.0, Math.min(root.speed, 100.0));
    property <float> fill_progress: root.bounded_speed / 100.0;
    property <int> particle_count_per_side: Math.round(root.bounded_speed * 0.24);
    // Speed scale: white -> blue -> yellow -> red.
    property <color> speed_color: root.bounded_speed < 35.0
        ? #ffffff.mix(#3b82f6, root.bounded_speed / 35.0)
        : (root.bounded_speed < 70.0
        ? #3b82f6.mix(#facc15, (root.bounded_speed - 35.0) / 35.0)
        : #facc15.mix(#ef4444, (root.bounded_speed - 70.0) / 30.0));

    width: 460px;
    height: 480px;
    background: #000000;

    property <float> particle_tick: 0.0;

    Timer {
        interval: 16ms;
        running: emo.gps_screen;
        triggered => {
            // The stream is slow at low GPS speeds and visibly accelerates as
            // the speed rises. At zero speed there are no visible particles.
            let speed_mult = 0.001 + root.fill_progress * 0.032;
            root.particle_tick = Math.mod(root.particle_tick + speed_mult, 1.0);
        }
    }

    function bracket-pos-x(t: float, right: bool) -> length {
        // Match the two-segment, rounded bracket path below.
        let q = t < 0.5 ? t * 2.0 : (t - 0.5) * 2.0;
        let u = 1.0 - q;
        if t < 0.5 {
            let left_x = u * u * u * 168.0 + 3.0 * u * u * q * 140.0
                + 3.0 * u * q * q * 120.0 + q * q * q * 120.0;
            return (right ? 460.0 - left_x : left_x) * 1px;
        }
        let left_x = u * u * u * 120.0 + 3.0 * u * u * q * 120.0
            + 3.0 * u * q * q * 140.0 + q * q * q * 168.0;
        return (right ? 460.0 - left_x : left_x) * 1px;
    }

    function bracket-pos-y(t: float) -> length {
        let q = t < 0.5 ? t * 2.0 : (t - 0.5) * 2.0;
        let u = 1.0 - q;
        if t < 0.5 {
            return (u * u * u * 330.0 + 3.0 * u * u * q * 330.0
                + 3.0 * u * q * q * 290.0 + q * q * q * 240.0) * 1px;
        }
        return (u * u * u * 240.0 + 3.0 * u * u * q * 190.0
            + 3.0 * u * q * q * 150.0 + q * q * q * 150.0) * 1px;
    }

    function particle-phase(i: int) -> float {
        let idx = i >= 24 ? (i - 24) : i;
        return Math.mod(root.particle_tick + idx * 0.0417 + (i >= 24 ? 0.021 : 0.0), 1.0);
    }

    function particle-travel(i: int) -> float {
        let phase = root.particle-phase(i);
        // Ease into the center so the particles visibly travel, rather than
        // blinking between two fixed positions.
        return 1.0 - (1.0 - phase) * (1.0 - phase);
    }

    function particle-x(i: int) -> length {
        let is_right = i >= 24;
        let idx = is_right ? (i - 24) : i;
        let lane = Math.mod(idx, 6);
        let start_x = is_right ? 394.0 - lane * 5.0 : 66.0 + lane * 5.0;
        let end_x = is_right ? 286.0 - lane * 3.0 : 174.0 + lane * 3.0;
        let travel = root.particle-travel(i);
        return (is_right
            ? start_x - (start_x - end_x) * travel
            : start_x + (end_x - start_x) * travel) * 1px;
    }

    function particle-y(i: int) -> length {
        let idx = i >= 24 ? (i - 24) : i;
        let lane = Math.mod(idx, 6);
        let row = Math.floor(idx / 6.0);
        let start_y = 136.0 + lane * 8.0 + row * 5.0;
        let end_y = 196.0 + lane * 3.0 + row * 4.0;
        return (start_y + (end_y - start_y) * root.particle-travel(i)) * 1px;
    }

    function particle-opacity(i: int) -> float {
        let phase = root.particle-phase(i);
        return Math.min(1.0, phase * 4.0) * Math.min(1.0, (1.0 - phase) * 3.0);
    }

    function particle-color(i: int) -> color {
        return #ffffff.mix(root.speed_color, root.particle-phase(i));
    }

    function particle-glow(i: int) -> color {
        return root.speed_color.transparentize(65%);
    }

    function particle-size(i: int) -> length {
        let idx = Math.mod(i, 4);
        return (idx == 0 ? 5.0 : (idx == 1 ? 4.0 : (idx == 2 ? 3.5 : 3.0))) * 1px;
    }

    if root.show_bt_log: VerticalLayout {
        padding: 24px;
        spacing: 14px;

        Text {
            text: "BLUETOOTH CONSOLE · [B] TO CLOSE";
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: #38bdf8;
        }

        Text {
            text: root.latest_bt_log;
            font-size: 12px;
            font-family: "monospace";
            color: #a5f3fc;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }

    if !root.show_bt_log && emo.gps_screen: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000;

        // Smooth background curved brackets, pulled inward from the panel
        // dividers so the center area has clear breathing room.
        Path {
            width: 460px;
            height: 480px;
            stroke: #262930;
            stroke-width: 5px;
            stroke-line-cap: round;
            fill: transparent;
            commands: "M 168 330 C 140 330 120 290 120 240 C 120 190 140 150 168 150 M 292 150 C 320 150 340 190 340 240 C 340 290 320 330 292 330";
        }

        // Reveal the active stroke from the exact bottom endpoint upward.
        if root.fill_progress > 0.005: Rectangle {
            x: 0px;
            y: (348.0 - 216.0 * root.fill_progress - 12.0) * 1px;
            width: 460px;
            height: (216.0 * root.fill_progress + 24.0) * 1px;
            clip: true;

            // Outer glow path
            Path {
                x: 0px;
                y: -(348.0 - 216.0 * root.fill_progress - 12.0) * 1px;
                width: 460px;
                height: 480px;
                stroke: root.speed_color.transparentize(72%);
                stroke-width: 14px;
                stroke-line-cap: round;
                fill: transparent;
                commands: "M 168 330 C 140 330 120 290 120 240 C 120 190 140 150 168 150 M 292 150 C 320 150 340 190 340 240 C 340 290 320 330 292 330";
            }

            // Core solid active stroke
            Path {
                x: 0px;
                y: -(348.0 - 216.0 * root.fill_progress - 12.0) * 1px;
                width: 460px;
                height: 480px;
                stroke: root.speed_color;
                stroke-width: 5px;
                stroke-line-cap: round;
                fill: transparent;
                commands: "M 168 330 C 140 330 120 290 120 240 C 120 190 140 150 168 150 M 292 150 C 320 150 340 190 340 240 C 340 290 320 330 292 330";
            }
        }

        // Leading tip glowing beads gliding along the curves
        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, false) - 7px;
            y: root.bracket-pos-y(root.fill_progress) - 7px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.speed_color.transparentize(65%);
        }
        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, false) - 4px;
            y: root.bracket-pos-y(root.fill_progress) - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.speed_color;
        }

        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, true) - 7px;
            y: root.bracket-pos-y(root.fill_progress) - 7px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.speed_color.transparentize(65%);
        }
        if root.fill_progress > 0.01: Rectangle {
            x: root.bracket-pos-x(root.fill_progress, true) - 4px;
            y: root.bracket-pos-y(root.fill_progress) - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.speed_color;
        }

        // Round particles fly from both outer edges toward the center. Their
        // count and travel speed are both driven by the live GPS speed.
        for i in 48: Rectangle {
            visible: Math.mod(i, 24) < root.particle_count_per_side
                && root.particle-opacity(i) > 0.01;
            x: root.particle-x(i) - 3px;
            y: root.particle-y(i) - 3px;
            width: root.particle-size(i) + 6px;
            height: root.particle-size(i) + 6px;
            border-radius: (root.particle-size(i) + 6px) / 2;
            background: root.particle-glow(i);
            opacity: root.particle-opacity(i);
        }
        for i in 48: Rectangle {
            visible: Math.mod(i, 24) < root.particle_count_per_side
                && root.particle-opacity(i) > 0.01;
            x: root.particle-x(i);
            y: root.particle-y(i);
            width: root.particle-size(i);
            height: root.particle-size(i);
            border-radius: root.particle-size(i) / 2;
            background: root.particle-color(i);
            opacity: root.particle-opacity(i);
        }

        Text {
            x: 48px;
            y: 134px;
            width: 364px;
            height: 170px;
            text: Math.round(root.speed);
            font-size: 150px;
            font-weight: 900;
            color: root.speed_color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    emo := EmoEyes {
        x: Math.round((parent.width - self.width) / 2px) * 1px;
        y: Math.round((parent.height - self.height) / 2px) * 1px;
        speed: root.speed;
        random_seed: root.random_seed;
        enabled: !root.show_bt_log;
        visible: !root.show_bt_log && !self.gps_screen;
    }
}
