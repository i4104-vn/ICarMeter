[Unit]
Description=ICarMeter Bluetooth RFCOMM/SPP service
Requires=bluetooth.service icarmeter-bluetooth.service
Wants=icarmeter-bt-agent.service
After=bluetooth.service icarmeter-bluetooth.service icarmeter-bt-agent.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/icarmeter/icarmeter-api.py
Restart=always
RestartSec=3s
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
