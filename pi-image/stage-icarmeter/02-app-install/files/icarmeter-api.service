[Unit]
Description=ICarMeter Bluetooth RFCOMM/SPP service
After=bluetooth.service icarmeter-bluetooth.service
Wants=icarmeter-bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/icarmeter/icarmeter-api.py
Restart=always
RestartSec=3s
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
