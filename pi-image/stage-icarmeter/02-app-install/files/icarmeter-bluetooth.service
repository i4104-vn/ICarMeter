[Unit]
Description=ICarMeter Bluetooth adapter setup (TPMS LE Scanner & SPP)
Requires=bluetooth.service
Wants=hciuart.service
After=bluetooth.service hciuart.service dbus.service

[Service]
Type=oneshot
ExecStart=/opt/icarmeter/icarmeter-bt-init.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
