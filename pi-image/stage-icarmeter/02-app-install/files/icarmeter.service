[Unit]
Description=ICarMeter Car Digital Dashboard
After=local-fs.target systemd-udevd.service bluetooth.target plymouth-quit-wait.service plymouth-quit.service
Wants=bluetooth.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/icarmeter
ExecStart=/opt/icarmeter/car_dashboard
Restart=always
RestartSec=1
StandardInput=null
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1

[Install]
WantedBy=multi-user.target
