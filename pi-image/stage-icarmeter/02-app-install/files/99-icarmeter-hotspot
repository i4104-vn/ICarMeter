#!/bin/bash
# ==============================================================================
# NetworkManager Dispatcher: Auto-reactivate ICarMeter Hotspot
# Triggered INSTANTLY by NM when any connection goes down on wlan0.
# This is Layer 3 of the always-alive hotspot protection.
# ==============================================================================

INTERFACE="$1"
ACTION="$2"
CONN_NAME="ICarMeter-Hotspot"

# Only act on wlan0 events
[ "$INTERFACE" = "wlan0" ] || exit 0

case "$ACTION" in
    down|deactivating)
        # A connection on wlan0 went down — immediately bring hotspot back
        logger -t "icarmeter-hotspot-dispatcher" "wlan0 went $ACTION — re-activating $CONN_NAME"
        sleep 1
        rfkill unblock wifi 2>/dev/null || true
        nmcli radio wifi on  2>/dev/null || true
        nmcli connection up "$CONN_NAME" 2>/dev/null || true
        ;;
    up)
        # A connection came up on wlan0 — if it's NOT our hotspot, kill it
        ACTIVE_CONN="${CONNECTION_ID:-}"
        if [ -n "$ACTIVE_CONN" ] && [ "$ACTIVE_CONN" != "$CONN_NAME" ]; then
            logger -t "icarmeter-hotspot-dispatcher" "Foreign connection '$ACTIVE_CONN' on wlan0 — replacing with $CONN_NAME"
            nmcli connection down "$ACTIVE_CONN" 2>/dev/null || true
            sleep 1
            nmcli connection up "$CONN_NAME" 2>/dev/null || true
        fi
        ;;
esac
