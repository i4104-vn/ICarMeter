# ==============================================================================
# ICarMeter - Raspberry Pi OS Custom Image Configuration
# ==============================================================================

# Image naming and base OS version
IMG_NAME="icarmeter"
RELEASE="bookworm"
ARCH="arm64"

# User Credentials & Autologin prep
FIRST_USER_NAME="i4104"
FIRST_USER_PASS="icarmeter"
DISABLE_FIRST_BOOT_USER_RENAME=1
PASSWORDLESS_SUDO=1

# Networking & Remote Management
TARGET_HOSTNAME="i4104"
ENABLE_SSH=0

# Localization & Region
LOCALE_DEFAULT="en_US.UTF-8"
TIMEZONE_DEFAULT="Asia/Ho_Chi_Minh"
KEYBOARD_KEYMAP="us"
KEYBOARD_LAYOUT="English (US)"

# Output Archive Format (none to output raw .img ready for flashing without unzipping)
DEPLOY_COMPRESSION="none"
COMPRESSION_LEVEL=1

# Pipeline Stages to run:
# Stage 0: Bootstrap filesystem
# Stage 1: Minimal bootable system
# Stage 2: Raspberry Pi OS Lite base
BASE_DIR="${BASE_DIR:-/pi-gen}"
STAGE_LIST="${BASE_DIR}/stage0 ${BASE_DIR}/stage1 ${BASE_DIR}/stage2 ${BASE_DIR}/stage-icarmeter"
